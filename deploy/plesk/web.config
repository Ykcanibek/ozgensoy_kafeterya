<?xml version="1.0" encoding="utf-8"?>
<!--
  Özgensoy Kafeterya — Plesk (Windows / IIS + iisnode) ayarı. Site kök klasörüne (httpdocs) konur.
  Bütün istekler Node uygulamasına (server.cjs) gider; IIS hiçbir dosyayı doğrudan sunmaz.
-->
<configuration>
  <system.webServer>
    <!-- WebSocket bağlantısını IIS değil Node (socket.io) karşılasın; desteklenmezse socket.io kendiliğinden yoklamaya geçer -->
    <webSocket enabled="false" />

    <handlers>
      <add name="iisnode" path="server.cjs" verb="*" modules="iisnode" />
    </handlers>

    <!--
      nodeProcessCountPerApplication="1": anlık bildirimler (socket.io) tek süreçte tutulur; artırmayın.
      enableXFF: gerçek müşteri IP'si (QR sipariş hız sınırı). watchedFiles: bu dosyalar değişince uygulama yeniden başlar.
      Plesk farklı bir Node sürümü kullanıyorsa nodeProcessCommandLine="C:\...\node.exe" ekleyin.
    -->
    <iisnode
      nodeProcessCountPerApplication="1"
      enableXFF="true"
      watchedFiles="web.config;server.cjs;backend\.env"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      debuggingEnabled="false"
      node_env="production" />

    <rewrite>
      <rules>
        <rule name="Node uygulaması" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.cjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- Kaynak kodu, ayar dosyası (.env), paketler ve kayıtlar internetten hiçbir şekilde açılamaz -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="backend" />
          <add segment="frontend" />
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment=".env" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="12582912" />
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
