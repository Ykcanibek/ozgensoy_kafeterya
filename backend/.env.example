PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=Kafe_Otomasyon

# Oturum imzalama anahtarı: en az 32 karakterlik rastgele bir değer girin (boş bırakılırsa sunucu açılmaz).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Tarayıcıdan API'ye erişebilecek adresler (virgülle ayrılır). Boş bırakılırsa her adrese izin verilir (yalnızca geliştirme için).
# Örnek: CORS_ORIGIN=http://localhost:3000,http://192.168.1.20:3000
CORS_ORIGIN=

# Nginx vb. proxy arkasında çalışırken true yapın (gerçek müşteri IP'si; QR sipariş hız sınırı için)
TRUST_PROXY=false

# Müşteri QR menüsünün alan adı (virgülle birden fazla): bu adresten yalnızca menü ve herkese açık API açılır
# Örnek: MENU_HOST=ozgensoykafeterya.com,www.ozgensoykafeterya.com
MENU_HOST=

# Derlenmiş arayüzü (frontend/dist) bu sunucudan sunmayı kapatmak için false yapın (ayrı web sunucusu kullanılıyorsa)
SERVE_FRONTEND=true

# Gizli geliştirici hesabı: kullanıcı tablosu boşken ilk açılışta oluşturulur, sitede listelenmez
DEV_ACCOUNT_NAME=
DEV_ACCOUNT_USERNAME=
DEV_ACCOUNT_PASSWORD=
DEV_ACCOUNT_PHONE=

# İşletme saat dilimi: gün sonu ve raporlar sunucunun bulunduğu yerden bağımsız olarak bu saate göre hesaplanır.
# (Varsayılanlar Türkiye içindir; boş bırakılabilir.)
APP_TIMEZONE=Europe/Istanbul
DB_TIMEZONE=+03:00
